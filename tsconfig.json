{
  "compilerOptions": {
    "target": "es2022",
    // es2024 for the resizable ArrayBuffer the FIT encoder allocates.
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  // The browser half has its own config: DOM and workers-types disagree.
  "exclude": ["src/client/**"]
}
