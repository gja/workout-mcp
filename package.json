{
  "name": "workout-mcp",
  "version": "0.1.0",
  "description": "Plan workouts over MCP, export them as Garmin FIT files. Cloudflare Workers + D1.",
  "scripts": {
    "dev": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "test": "vite build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "db:local": "wrangler d1 migrations apply workout-mcp --local",
    "db:remote": "wrangler d1 migrations apply workout-mcp --remote",
    "db:new": "wrangler d1 migrations create workout-mcp",
    "db:list": "wrangler d1 migrations list workout-mcp --remote",
    "build": "vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gja/workout-mcp.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gja/workout-mcp/issues"
  },
  "homepage": "https://github.com/gja/workout-mcp#readme",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@garmin/fitsdk": "^21.214.0",
    "arctic": "^3.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.131.0"
  },
  "private": true,
  "type": "module"
}
