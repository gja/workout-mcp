{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workout-mcp",
	"main": "src/index.ts",
	// Vite builds both the client and the Worker. Running it here means a bare
	// `wrangler deploy` — which is what Workers Builds runs — cannot ship a
	// Worker whose assets directory was never built.
	"build": {
		"command": "npm run build"
	},
	"compatibility_date": "2025-09-01",
	// The dashboard and the OAuth consent page, built by Vite. Anything not
	// matched by /mcp, /api, /oauth or /export is served from here.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"vars": {
		"APP_NAME": "Workouts"
		// Sign-in is configured with secrets, not here. Google alone is enough:
		//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
		// Apple is optional and needs a paid developer account:
		//   APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
		// Optional allowlist, e.g. "me@example.com,@myteam.com":
		//   ALLOWED_EMAILS
		//
		// Encrypts the API keys athletes paste in to connect a training
		// platform. Any passphrase; without it those connections are refused
		// rather than stored in the clear:
		//   CREDENTIALS_SECRET
	},
	// The OAuth provider stores clients, grants and tokens here.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "ff5cb050b73a410f9b1482c2d18d1f53"
		}
	],
	// Schema lives in ./migrations, applied with `npm run db:remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "workout-mcp",
			"database_id": "8c2f9ce3-5892-44ec-883f-7149426219c6"
		}
	],
	// Nightly credential housekeeping (03:00 UTC) — expired sessions,
	// abandoned sign-ins, stale OAuth grants — and an hourly pass that reads
	// completions back off the connected training platforms. src/index.ts
	// tells the two apart by the cron that fired.
	//
	// Workouts are not swept: the retention window and the per-user cap are
	// enforced on the way in and on every read, so nothing has to delete an
	// athlete's older sessions to hold the line. See src/db.ts.
	"triggers": {
		"crons": [
			"0 3 * * *",
			"20 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
