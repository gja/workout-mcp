{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workout-mcp",
	"main": "src/index.ts",
	// Vite builds both the client and the Worker. Running it here means a bare
	// `wrangler deploy` — which is what Workers Builds runs — cannot ship a
	// Worker whose assets directory was never built.
	"build": {
		"command": "npm run build"
	},
	"compatibility_date": "2025-09-01",
	// The dashboard and the OAuth consent page, built by Vite. Anything not
	// matched by /mcp, /api, /oauth or /export is served from here.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"vars": {
		"APP_NAME": "Workouts"
		// Sign-in is configured with secrets, not here. Google alone is enough:
		//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
		// Apple is optional and needs a paid developer account:
		//   APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
		// Optional allowlist, e.g. "me@example.com,@myteam.com":
		//   ALLOWED_EMAILS
		// Syncing to the Garmin Connect calendar needs a Garmin Connect
		// Developer Program app with the Training API enabled. Both together,
		// or the Garmin panel does not appear at all:
		//   GARMIN_CLIENT_ID, GARMIN_CLIENT_SECRET
		// Optional, and recommended: encrypts the stored Garmin tokens, so the
		// client secret can be rotated without everyone reconnecting.
		//   GARMIN_ENCRYPTION_KEY
	},
	// The OAuth provider stores clients, grants and tokens here.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "ff5cb050b73a410f9b1482c2d18d1f53"
		}
	],
	// Schema lives in ./migrations, applied with `npm run db:remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "workout-mcp",
			"database_id": "8c2f9ce3-5892-44ec-883f-7149426219c6"
		}
	],
	// Nightly retention sweep, then the push to Garmin (03:00 UTC).
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
